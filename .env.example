ADMIN_PASSWORD=change-me-to-a-long-random-secret
ADMIN_SESSION_SECRET=change-me-to-another-long-random-secret

# Production (Vercel): attach a Blob store to the project (OIDC / BLOB_STORE_ID)
# or paste a read-write token so published outlooks persist across deploys.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Optional: force Blob access mode if needed
# BLOB_ACCESS=public
