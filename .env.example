# Optional. Most SkyWatch features use public BoM / third-party APIs with no keys.
# BLOB_READ_WRITE_TOKEN=

# Durable Community + Archive storage (preferred). Upstash Redis REST.
# Required on Railway so community/archive survive restarts (no /tmp durability).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Community admin-only post delete (keep private — only you should know this).
# COMMUNITY_ADMIN_SECRET=

# --- Vercel Hobby budget (auto-on when VERCEL=1) ---
# Force Hobby-safe cuts on non-Vercel hosts, or override auto detection:
# SKYWATCH_HOBBY=1
# SKYWATCH_HOBBY=0
# Restore full server warm / WS lightning / radar recolour on Vercel (may hit fair-use):
# SKYWATCH_FULL_COMPUTE=1
# Radar tiles: direct RainViewer CDN (default on Hobby) vs SkyWatch dBZ recolour proxy:
# SKYWATCH_RADAR_DIRECT=1
# SKYWATCH_RADAR_DIRECT=0
# Server-side radar/satellite cache warm (off on Hobby by default):
# SKYWATCH_WARM=1

# SkyWatch AI sidecar (local Docker / Railway — not runnable on Vercel Hobby)
# SKYWATCH_AI_URL=http://127.0.0.1:43137
# Production example: SKYWATCH_AI_URL=https://skywatch-ai.up.railway.app
# SKYWATCH_AI_API_KEY=   # optional bearer; must match sidecar SKYWATCH_AI_API_KEY
# SKYWATCH_AI_CHECKPOINT=/absolute/path/to/checkpoints/v1-etl.pt


# Oracle Cloud / Docker Compose (optional HTTPS via Caddy)
# SKYWATCH_DOMAIN=skywatch.example.com
# CADDY_EMAIL=you@example.com
