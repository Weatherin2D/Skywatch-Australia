    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.41.0",
    "mqtt": "^5.16.0",
    "next": "16.3.4",
    "pngjs": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
