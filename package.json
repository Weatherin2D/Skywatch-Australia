{
  "name": "cloudcountry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev --hostname 127.0.0.1 --port 43127",
    "dev:pages": "npm --prefix pages-site run dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
