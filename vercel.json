{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/weather/archive/ingest",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "src/app/api/[[...slug]]/route.ts": {
      "maxDuration": 60
    }
  }
}
